{
  "name": "iptv-stream",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "npx expo start",
    "android": "npx expo run:android",
    "ios": "npx expo run:ios",
    "generate-assets": "node generate-assets.js",
    "build:apk": "npx eas-cli build --platform android --profile production --local",
    "build:apk:preview": "npx eas-cli build --platform android --profile preview",
    "build:apk:dev": "npx eas-cli build --platform android --profile development",
    "prebuild": "npx expo prebuild --platform android --clean",
    "postinstall": "node generate-assets.js"
  },
  "dependencies": {
    "expo": "~54.0.0",
    "expo-status-bar": "~2.0.0",
    "expo-linear-gradient": "~14.0.0",
    "expo-av": "~15.0.0",
    "react": "18.3.1",
    "react-native": "0.76.7",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native-stack": "^6.11.0",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-gesture-handler": "~2.20.2",
    "@react-native-async-storage/async-storage": "1.23.1",
    "axios": "^1.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "eas-cli": "^14.0.0"
  }
}
